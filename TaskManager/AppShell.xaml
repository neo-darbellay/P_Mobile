<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TaskManager.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:lists="clr-namespace:TaskManager.Pages"
    Title="TaskManager">

    <Shell.TitleView>
        <Label Text="{Binding Source={RelativeSource AncestorType={x:Type Shell}}, Path=Title}"
               FontFamily="InriaSansBold"
               FontSize="24"
               TextColor="Black"
               HorizontalOptions="Start"
               VerticalOptions="Center" />
    </Shell.TitleView>

    <ShellContent
        Shell.BackgroundColor="#D9D9D9"
        ContentTemplate="{DataTemplate lists:ShowLists}"
        Route="MainPage" />

</Shell>
