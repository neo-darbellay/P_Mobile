<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="TaskManager.Pages.ShowTasks"
             BackgroundColor="#E9E9E9"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">
        <VerticalStackLayout Padding="15,20,15,10"
                             Spacing="12">

            <!-- Name of the list -->
            <Grid ColumnDefinitions="*,Auto"
                  VerticalOptions="Center">

                <Label Text="En chargement..."
                       FontSize="22"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       x:Name="ListTitle"/>

                <!-- Search -->
                <Border Grid.Column="1"
                        BackgroundColor="White"
                        Stroke="#BDBDBD"
                        StrokeShape="RoundRectangle 15"
                        Padding="10,4"
                        WidthRequest="120"
                        HeightRequest="35">

                    <Entry Placeholder="Recherche..."
                            FontSize="12"
                            BackgroundColor="Transparent"
                            Margin="0,-8,0,0"/>

                </Border>
            </Grid>

            <!-- Description -->
            <Label Text="En chargement..."
                   HorizontalOptions="Center"
                   FontSize="13"
                   x:Name="ListDescription"/>

            <!-- Todo -->
            <Label Text="À faire"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>

        </VerticalStackLayout>

        <ScrollView Grid.Row="1">

            <VerticalStackLayout Padding="10,0"
                                 Spacing="10">

                 <!-- Tasks to do -->
                <CollectionView x:Name="TasksTodo"
                                SelectionMode="None">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>

                            <Border BackgroundColor="#D8D8D8"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 18"
                                    Padding="10"
                                    Margin="0,2">

                                <Grid ColumnDefinitions="45,*,70,35">

                                    <!-- Checkbox -->
                                    <CheckBox Grid.Column="0"
                                              VerticalOptions="Center"
                                              HorizontalOptions="Center"
                                              IsChecked="{Binding Done}"
                                              CheckedChanged="OnTaskCheckedChanged"/>

                                    <!-- Task -->
                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="2">

                                        <VerticalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnEditTapped"
                                                                  CommandParameter="{Binding .}"/>
                                        </VerticalStackLayout.GestureRecognizers>

                                        <!-- Title -->
                                        <Label Text="{Binding Title}"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               LineBreakMode="TailTruncation"/>

                                        <!-- Description -->
                                        <Label Text="{Binding Description}"
                                               FontSize="12"
                                               TextColor="#444444"
                                               LineBreakMode="TailTruncation"/>
                                    </VerticalStackLayout>

                                    <!-- Date -->
                                    <Label Grid.Column="2"
                                           Text="{Binding DueDisplay}"
                                           FontSize="12"
                                           VerticalOptions="Center"
                                           HorizontalTextAlignment="Center"/>

                                    <!-- Delete -->
                                    <Border Grid.Column="3"
                                            BackgroundColor="Transparent"
                                            StrokeThickness="0">

                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnDeleteClicked"
                                                                  CommandParameter="{Binding Id}"/>
                                        </Border.GestureRecognizers>

                                        <Border.Behaviors>
                                            <toolkit:TouchBehavior PressedOpacity="0.6"
                                                                   PressedScale="0.95"/>
                                        </Border.Behaviors>

                                        <Image Source="trash.png"
                                               WidthRequest="22"
                                               HeightRequest="22"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Center"/>
                                    </Border>

                                </Grid>

                            </Border>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

                <!-- Separator -->
                <BoxView HeightRequest="1"
                         Margin="0,10"
                         Color="#808080"/>

                <!-- Done -->
                <Label Text="Terminées"
                       FontSize="24"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"/>

                <!-- Tasks done -->
                <CollectionView x:Name="TasksDone"
                                SelectionMode="None">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>

                            <Border BackgroundColor="#D8D8D8"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 18"
                                    Padding="10"
                                    Margin="0,2">

                                <Grid ColumnDefinitions="45,*,70,35">

                                    <!-- Checkbox -->
                                    <CheckBox Grid.Column="0"
                                              VerticalOptions="Center"
                                              HorizontalOptions="Center"
                                              IsChecked="{Binding Done}"
                                              CheckedChanged="OnTaskCheckedChanged"/>

                                    <!-- Task -->
                                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="2">

                                        <VerticalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnEditTapped"
                                                                  CommandParameter="{Binding .}"/>
                                        </VerticalStackLayout.GestureRecognizers>

                                        <!-- Title -->
                                        <Label Text="{Binding Title}"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               LineBreakMode="TailTruncation"/>

                                        <!-- Description -->
                                        <Label Text="{Binding Description}"
                                               FontSize="12"
                                               TextColor="#444444"
                                               LineBreakMode="TailTruncation"/>
                                    </VerticalStackLayout>

                                    <!-- Date -->
                                    <Label Grid.Column="2"
                                           Text="{Binding DueDisplay}"
                                           FontSize="12"
                                           VerticalOptions="Center"
                                           HorizontalTextAlignment="Center"/>

                                    <!-- Delete -->
                                    <Border Grid.Column="3"
                                            BackgroundColor="Transparent"
                                            StrokeThickness="0">

                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnDeleteClicked"/>
                                        </Border.GestureRecognizers>

                                        <Border.Behaviors>
                                            <toolkit:TouchBehavior PressedOpacity="0.6"
                                                   PressedScale="0.95"/>
                                        </Border.Behaviors>

                                        <Image Source="trash.png"
                                               WidthRequest="22"
                                               HeightRequest="22"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Center"/>
                                    </Border>

                                <!-- Line to show it's done -->
                                <BoxView HeightRequest="2"
                                         BackgroundColor="#3A3A3A"
                                         Rotation="-12"
                                         VerticalOptions="Center"
                                         Margin="-5,0"/>
                                </Grid>

                            </Border>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

            </VerticalStackLayout>

        </ScrollView>

        <!-- Buttons -->
        <Grid Grid.Row="2"
              ColumnDefinitions="*,*"
              Padding="40,10,40,25">

            <!-- Home -->
            <Border Grid.Column="0"
                    WidthRequest="65"
                    HeightRequest="65"
                    HorizontalOptions="Start"
                    BackgroundColor="#B5B5B5"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 15">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHomeTapped"/>
                </Border.GestureRecognizers>

                <Border.Behaviors>
                    <toolkit:TouchBehavior PressedOpacity="0.6"
                                           PressedScale="0.95"/>
                </Border.Behaviors>

                <Image Source="home.png"
                       WidthRequest="26"
                       HeightRequest="26"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Border>

            <!-- Add -->
            <Border Grid.Column="1"
                    WidthRequest="65"
                    HeightRequest="65"
                    HorizontalOptions="End"
                    BackgroundColor="#B5B5B5"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 15">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAddTapped"/>
                </Border.GestureRecognizers>

                <Border.Behaviors>
                    <toolkit:TouchBehavior PressedOpacity="0.6"
                                           PressedScale="0.95"/>
                </Border.Behaviors>

                <Image Source="add.png"
                       WidthRequest="26"
                       HeightRequest="26"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Border>

        </Grid>

    </Grid>

</ContentPage>