<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TaskManager.Pages.ShowTasks"
             xmlns:components="clr-namespace:TaskManager.Components"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Margin="20">

            <Label Text="En chargement..."
                   FontSize="16"
                   HorizontalOptions="Center"
                   TextColor="Gray" 
                   x:Name="ListDescription"/>

            <Label Text="À faire"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <!-- List of tasks to do -->
            <CollectionView x:Name="TasksTodo">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#D9D9D9"
                                StrokeShape="RoundRectangle 20"
                                Padding="16"
                                Margin="10">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Checkbox -->
                                <CheckBox Grid.Column="0"
                                    WidthRequest="28"
                                    HeightRequest="28"
                                    Margin="5"
                                    IsChecked="{Binding Done}"
                                    CheckedChanged="OnTaskCheckedChanged"/>

                                <!-- Content -->
                                <Grid Grid.Column="1" Margin="15,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Title -->
                                    <Label x:Name="TitleText"
                                           Text="{Binding Title}"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           VerticalTextAlignment="Start"/>

                                    <!-- Description -->
                                    <Label x:Name="DescriptionText"
                                           Grid.Row="1"
                                           Text="{Binding Description}"
                                           FontSize="15"
                                           Margin="0,6,0,0"/>

                                    <!-- Tags -->
                                    <CollectionView x:Name="TagsControl"
                                                    Grid.Row="2"
                                                    Margin="0,8,0,0"
                                                    ItemsSource="{Binding Tags}">

                                        <CollectionView.ItemTemplate>
                                            <DataTemplate>
                                                <Border StrokeShape="RoundRectangle 12"
                                                        Padding="10,4"
                                                        Margin="0,0,8,0"
                                                        Background="{Binding Color}">
                                                    <Label Text="{Binding Name}" />
                                                </Border>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>
                                </Grid>

                                <!-- Date -->
                                <Label Grid.Column="2"
                                       Text="{Binding DueDisplay}"
                                       VerticalTextAlignment="Center"
                                       Margin="20,0"
                                       FontSize="18"/>

                                <!-- Delete -->
                                <Border Grid.Column="3"
                                        Width="30"
                                        Height="30"
                                        Margin="10,0">

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnAddTapped"/>
                                    </Border.GestureRecognizers>

                                    <Border.Behaviors>
                                        <toolkit:TouchBehavior PressedOpacity="0.6"
                                                               PressedScale="0.95"/>
                                    </Border.Behaviors>

                                    <FlexLayout AlignItems="Center" JustifyContent="Center">
                                        <Image Source="trash.png"/>
                                    </FlexLayout>
                                </Border>
                            </Grid>

                            <!-- Smart Layout Triggers -->
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>

                                        <!-- Hide Description if empty -->
                                        <DataTrigger TargetType="Grid"
                                                     Binding="{Binding Description}"
                                                     Value="{x:Null}">

                                            <Setter TargetName="DescriptionText"
                                                    Property="IsVisible"
                                                    Value="False" />

                                        </DataTrigger>

                                        <!-- Hide Tags if empty -->
                                        <DataTrigger TargetType="Grid"
                                                     Binding="{Binding Tags.Count}"
                                                     Value="0">

                                            <Setter TargetName="TagsControl"
                                                    Property="IsVisible"
                                                    Value="False" />
                                        </DataTrigger>

                                        <!-- Center Title when no Description AND no Tags -->
                                        <MultiTrigger TargetType="Grid">
                                            <MultiTrigger.Conditions>
                                                <BindingCondition Binding="{Binding Description}" Value="{x:Null}" />
                                                <BindingCondition Binding="{Binding Tags.Count}" Value="0" />
                                            </MultiTrigger.Conditions>

                                            <Setter TargetName="TitleText"
                                                    Property="VerticalOptions"
                                                    Value="Center" />

                                            <Setter TargetName="TitleText"
                                                    Property="Margin"
                                                    Value="0,8,0,8" />
                                        </MultiTrigger>

                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <BoxView HeightRequest="1" BackgroundColor="Black" />

            <Label Text="Terminées"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>

            <!-- List of tasks done -->
            <CollectionView x:Name="TasksDone">
                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Border StrokeThickness="0"
                                BackgroundColor="#D3D3D3"
                                StrokeShape="RoundRectangle 20"
                                Padding="15"
                                Margin="0,5">

                            <Grid ColumnDefinitions="60,*,80"
                                  RowDefinitions="Auto,Auto">

                                <CheckBox Grid.RowSpan="2"
                                          IsChecked="{Binding IsDone}"
                                          CheckedChanged="OnTaskCheckedChanged"
                                          VerticalOptions="Center"/>

                                <Label Grid.Column="1"
                                       Text="{Binding Title}"
                                       FontSize="20"/>

                                <Label Grid.Column="2"
                                       Text="{Binding Date}"
                                       HorizontalTextAlignment="End"/>

                                <Label Grid.Row="1"
                                       Grid.Column="1"
                                       Text="{Binding Description}"
                                       FontSize="14"/>

                                <Image Grid.Column="2"
                                       Grid.Row="1"
                                       Source="trash.png"
                                       HeightRequest="24"
                                       HorizontalOptions="End"/>
                            </Grid>

                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Buttons -->
            <HorizontalStackLayout Spacing="100"
                       HorizontalOptions="Center"
                       Margin="0,0,0,28">

                <!-- Home -->
                <Border WidthRequest="100"
                        HeightRequest="100"
                        BackgroundColor="#A0A0A0"
                        StrokeShape="RoundRectangle 16"
                        Padding="32">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHomeTapped"/>
                    </Border.GestureRecognizers>

                    <Border.Behaviors>
                        <toolkit:TouchBehavior PressedOpacity="0.6"
                                   PressedScale="0.95"/>
                    </Border.Behaviors>

                    <FlexLayout AlignItems="Center" JustifyContent="Center">
                        <Image Source="home.png"/>
                    </FlexLayout>
                </Border>

                <!-- Add -->
                <Border WidthRequest="100"
                        HeightRequest="100"
                        BackgroundColor="#A0A0A0"
                        StrokeShape="RoundRectangle 16"
                        Padding="32">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAddTapped"/>
                    </Border.GestureRecognizers>

                    <Border.Behaviors>
                        <toolkit:TouchBehavior PressedOpacity="0.6"
                                   PressedScale="0.95"/>
                    </Border.Behaviors>

                    <FlexLayout AlignItems="Center" JustifyContent="Center">
                        <Image Source="add.png"/>
                    </FlexLayout>
                </Border>

            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
