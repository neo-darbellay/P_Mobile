<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="TaskManager.Components.BottomButtons">

    <HorizontalStackLayout Spacing="100"
                           HorizontalOptions="Center"
                           Margin="0,0,0,28">

        <!-- Home -->
        <Border WidthRequest="100"
                HeightRequest="100"
                BackgroundColor="#A0A0A0"
                StrokeShape="RoundRectangle 16"
                Padding="32">

            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnHomeTapped"/>
            </Border.GestureRecognizers>

            <Border.Behaviors>
                <toolkit:TouchBehavior PressedOpacity="0.6"
                                       PressedScale="0.95"/>
            </Border.Behaviors>

            <FlexLayout AlignItems="Center" JustifyContent="Center">
                <Image Source="home.png"/>
            </FlexLayout>
        </Border>

        <!-- Add -->
        <Border WidthRequest="100"
                HeightRequest="100"
                BackgroundColor="#A0A0A0"
                StrokeShape="RoundRectangle 16"
                Padding="32">

            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnAddTapped"/>
            </Border.GestureRecognizers>

            <Border.Behaviors>
                <toolkit:TouchBehavior PressedOpacity="0.6"
                                       PressedScale="0.95"/>
            </Border.Behaviors>

            <FlexLayout AlignItems="Center" JustifyContent="Center">
                <Image Source="add.png"/>
            </FlexLayout>
        </Border>

    </HorizontalStackLayout>
</ContentView>
