<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:controls="clr-namespace:Maui.ColorPicker;assembly=Maui.ColorPicker"
    x:Class="TaskManager.Components.ColorPickerPopup">

    <VerticalStackLayout Padding="20" Spacing="20" BackgroundColor="White">

        <!-- Color picker -->
        <controls:ColorPicker
            x:Name="Picker"
            WidthRequest="200"
            HeightRequest="200"
            PickedColor="{Binding SelectedColor, Mode=TwoWay}" />

        <!-- Buttons -->
        <Grid ColumnDefinitions="*, *">
            <Button Grid.Column="0" Text="Annuler" Clicked="OnCancelClicked" BackgroundColor="Transparent" TextColor="Black" BorderColor="Black" BorderWidth="2"/>
            <Button Grid.Column="1" Text="Enregistrer" Clicked="OnDoneClicked" BackgroundColor="#0088FF"/>
        </Grid>

    </VerticalStackLayout>
</toolkit:Popup>